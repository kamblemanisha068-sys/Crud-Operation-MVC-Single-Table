@model FruitCrudOperation.Models.Fruit

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4> Add Fruit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="FruitName" class="control-label"></label>
                <input asp-for="FruitName" class="form-control" />
                <span asp-validation-for="FruitName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity_In_Kg" class="control-label"></label>
                <input asp-for="Quantity_In_Kg" class="form-control" />
                <span asp-validation-for="Quantity_In_Kg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price_Per_Kg" class="control-label"></label>
                <input asp-for="Price_Per_Kg" class="form-control" />
                <span asp-validation-for="Price_Per_Kg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
